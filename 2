local currentRoles = {}

local function detectRoles()
    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if char then
            local bp = p:FindFirstChild("Backpack")
            if char:FindFirstChild("Knife") or (bp and bp:FindFirstChild("Knife")) then
                currentRoles[p.Name] = "Katil"
            elseif char:FindFirstChild("Gun") or (bp and bp:FindFirstChild("Gun")) then
                currentRoles[p.Name] = "Şerif"
            else
                currentRoles[p.Name] = "Masum"
            end
        else
            currentRoles[p.Name] = "Masum"
        end
    end
end

local function getRole(p)
    if currentRoles[p.Name] then return currentRoles[p.Name] end
    return "Masum"
end

